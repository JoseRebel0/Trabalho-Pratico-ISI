  {
    "id": "a_alf",
    "type": "function",
    "z": "tab_arduino",
    "name": "alerta → 'A' / 'N'",
    "func": "// Recebe alertas publicados pelo ETL em isi/alertas e liga/desliga o LED do Arduino\n// payload esperado: {\"nivel\":\"ALERTA\"} ou {\"nivel\":\"NORMAL\"}\nconst n = (msg.payload && msg.payload.nivel) || String(msg.payload);\nmsg.payload = (n.toUpperCase() === 'ALERTA') ? 'A' : 'N';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 320,
    "y": 250,
    "wires": [
      [
        "a_serout"
      ]
    ]
  },
