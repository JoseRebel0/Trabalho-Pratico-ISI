  {
    "id": "a_prep",
    "type": "function",
    "z": "tab_arduino",
    "name": "validar + timestamp",
    "func": "// Valida a linha recebida do Arduino e acrescenta data/hora (o Arduino não tem relógio)\nconst p = msg.payload;\nif (typeof p !== 'object' || !p.sensor) {\n    node.warn('Linha ignorada (não é JSON válido): ' + JSON.stringify(p));\n    return null;\n}\np.ts = new Date().toISOString();\np.origem = 'arduino';\nmsg.topic = 'isi/sensores/' + p.sensor + '/leituras';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 500,
    "y": 80,
    "wires": [
      [
        "a_mqtt",
        "a_dbg"
      ]
    ]
  },
