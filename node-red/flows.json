  {
    "id": "tab_sim",
    "type": "tab",
    "label": "Simulador → MQTT",
    "disabled": true,
    "info": "Sensor simulado (plano B / testes). Gera leituras a cada 10 s com erros de propósito\n(nan, valores fora de gama, duplicados) para testar a limpeza no ETL."
  },
  {
    "id": "s_inj",
    "type": "inject",
    "z": "tab_sim",
    "name": "a cada 10 s",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "10",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 80,
    "wires": [
      [
        "s_fn"
      ]
    ]
  },
  {
    "id": "s_fn",
    "type": "function",
    "z": "tab_sim",
    "name": "gerar leitura SIM-01",
    "func": "// Sensor simulado: valores realistas + erros de propósito para testar a limpeza no ETL\nconst seq = (context.get('seq') || 0) + 1;\ncontext.set('seq', seq);\nconst hora = new Date().getHours() + new Date().getMinutes() / 60;\n// temperatura segue um ciclo diário (mín. ~5h, máx. ~15h)\nlet temp = 17 + 5 * Math.sin((hora - 9) / 24 * 2 * Math.PI) + (Math.random() - 0.5);\nlet hum  = 70 - 15 * Math.sin((hora - 9) / 24 * 2 * Math.PI) + (Math.random() - 0.5) * 3;\ntemp = Math.round(temp * 100) / 100;\nhum  = Math.round(hum * 100) / 100;\nconst r = Math.random();\nif (r < 0.04)      temp = 'nan';     // falha de leitura\nelse if (r < 0.07) temp = 85.0;      // valor absurdo (fora de gama)\nelse if (r < 0.09) hum  = -3;        // humidade impossível\nmsg.payload = { sensor: 'SIM-01', seq: seq, temp: temp, hum: hum,\n                ts: new Date().toISOString(), origem: 'simulador' };\n// de vez em quando repete a mensagem (duplicado) para testar remoção de duplicados\nif (Math.random() < 0.03) { node.send({ payload: msg.payload, topic: 'isi/sensores/SIM-01/leituras' }); }\nmsg.topic = 'isi/sensores/SIM-01/leituras';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 340,
    "y": 80,
    "wires": [
      [
        "s_mqtt",
        "s_dbg"
      ]
    ]
  },
  {
    "id": "s_mqtt",
    "type": "mqtt out",
    "z": "tab_sim",
    "name": "publicar leitura",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "cfg_broker",
    "x": 570,
    "y": 80,
    "wires": []
  },
